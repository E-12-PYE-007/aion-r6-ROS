<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>localisation</name>
  <version>0.0.0</version>
  <description>State-estimation nodes for the Aion R6 rover -- turns raw sensor sources into pose/velocity estimates.</description>
  <maintainer email="dan.strahan08@gmail.com">dstrahan</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>aion_msgs</depend>
  <depend>nav_msgs</depend>

  <exec_depend>robot_localization</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.0.0</version>
  <description>Launch files for bringing up the Aion R6 rover.</description>
  <maintainer email="dan.strahan08@gmail.com">dstrahan</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>control</exec_depend>
  <exec_depend>localisation</exec_depend>
  <exec_depend>ag_vla</exec_depend>
  <exec_depend>weed_geotagging</exec_depend>
  <exec_depend>data_collection</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>

  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
